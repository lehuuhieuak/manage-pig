# Kết nối từ container tới PostgreSQL đang chạy trên máy Docker, cổng 55439.
# Thông tin bên dưới dành cho compose.test.yaml; thay bằng kết nối riêng khi dùng dữ liệu thật.
DATABASE_URL=postgresql://manage_pig_test:manage_pig_test@host.docker.internal:55439/manage_pig_test
DEFAULT_FAMILY_ID=00000000-0000-4000-8000-000000000001

# Địa chỉ và cổng mở trên máy chạy Docker.
BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# Tùy chọn khi truy cập qua tên miền/reverse proxy; phải khớp origin của trình duyệt.
# APP_ORIGIN=https://so-trai.example.com
